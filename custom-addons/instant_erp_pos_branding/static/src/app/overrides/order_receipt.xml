<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Rebrand order receipts with instant-ERP -->
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

        <!-- Remove "Powered by Odoo" text -->
        <xpath expr="//div[@class='pos-receipt-order-data']/p[text()='Powered by Odoo']" position="replace">
            <p class="instant-erp-powered-by">Powered by instant-ERP</p>
        </xpath>

        <!-- Add instant-ERP footer after all content -->
        <xpath expr="//div[@class='after-footer']" position="after">
            <div t-if="props.data.instant_erp_footer" class="instant-erp-footer text-center mt-3">
                <div class="instant-erp-separator">--------------------------------</div>
                <div class="instant-erp-footer-text mt-2" style="white-space: pre-line;">
                    <t t-esc="props.data.instant_erp_footer"/>
                </div>
                <br/>
            </div>
        </xpath>

    </t>

</templates>
