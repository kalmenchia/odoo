<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add instant-ERP branding settings to POS Config form -->
    <record id="view_pos_config_form_instant_erp" model="ir.ui.view">
        <field name="name">pos.config.form.instant_erp</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <!-- Add instant-ERP branding section in settings container -->
            <xpath expr="//div[@class='row mt16 o_settings_container']" position="inside">
                <setting string="instant-ERP Branding" help="Customize your POS with instant-ERP branding">
                    <field name="enable_instant_erp_branding"/>
                    <div class="content-group mt16" invisible="not enable_instant_erp_branding">
                        <div class="row">
                            <label for="instant_erp_receipt_header" string="Receipt Header Text" class="col-lg-3 o_light_label"/>
                            <field name="instant_erp_receipt_header" widget="text" class="oe_inline"/>
                        </div>
                        <div class="row">
                            <label for="instant_erp_receipt_footer" string="Receipt Footer Text" class="col-lg-3 o_light_label"/>
                            <field name="instant_erp_receipt_footer" widget="text" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </xpath>

        </field>
    </record>

    <!-- Add instant-ERP logo fields to company form -->
    <record id="view_company_form_instant_erp" model="ir.ui.view">
        <field name="name">res.company.form.instant_erp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='logo']" position="after">
                <field name="instant_erp_pos_logo" widget="image" class="oe_avatar"/>
                <field name="instant_erp_receipt_logo" widget="image" class="oe_avatar"/>
            </xpath>

        </field>
    </record>

</odoo>
